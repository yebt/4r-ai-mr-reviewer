---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "4R — Self-hosted AI Merge Request Reviewer",
  description = "Self-hosted AI code review for GitLab merge requests, built around the 4R quality framework: Risk, Readability, Reliability, Resilience. Located findings, deterministic scoring, your infrastructure.",
} = Astro.props;

// Absolute URLs (canonical + social) resolve against `site` in astro.config; they
// fall back to relative paths if `site` is somehow unset so the build never fails.
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL("/og.png", site).href : "/og.png";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "4R — AI Merge Request Reviewer",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  ...(site ? { url: site.href } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="4R" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0a0a0b" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      /* Skip link — visually hidden until keyboard focus. */
      .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 100;
        transform: translateY(-150%);
        padding: 0.6rem 1rem;
        background: var(--accent);
        color: var(--accent-ink);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        transition: transform 0.15s ease;
      }
      .skip-link:focus { transform: translateY(0); }
    </style>
  </head>
  <body>
    <a href="#top" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
