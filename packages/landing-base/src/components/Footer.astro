---
import { SITE } from "../config";
---

<footer class="footer">
  <div class="wrap">
    <div class="cta-band">
      <h2 class="cta-title">Review the next merge request through four lenses.</h2>
      <a class="btn btn-accent" href={SITE.docs}>Get started <span class="arrow">→</span></a>
    </div>

    <div class="foot-grid">
      <div class="foot-brand">
        <span class="mono mark">4R</span>
        <p class="foot-note">
          Self-hosted AI code review for GitLab merge requests. Risk · Readability ·
          Reliability · Resilience.
        </p>
      </div>

      <nav class="foot-links" aria-label="Footer">
        <a href={SITE.docs}>Documentation</a>
        <a href={`${SITE.docs}/getting-started/quick-start`}>Quick start</a>
        <a href={`${SITE.docs}/self-hosting/deploy`}>Self-hosting</a>
        <a href={SITE.github} target="_blank" rel="noopener">GitHub ↗</a>
      </nav>
    </div>

    <div class="foot-base">
      <span class="mono">Secrets AES-256-GCM encrypted at rest · single Go binary</span>
      <span class="mono">GitLab-first · single-user</span>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-top: clamp(3.5rem, 8vw, 5.5rem); }
  .cta-band {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1.5rem;
    padding-bottom: clamp(3rem, 7vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }
  .cta-title {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    letter-spacing: -0.02em;
    max-width: 18ch;
  }

  .foot-grid {
    display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem;
    padding-block: 2.5rem;
  }
  @media (max-width: 640px) { .foot-grid { grid-template-columns: 1fr; } }
  .mark { font-size: 1.1rem; font-weight: 700; }
  .foot-note { color: var(--muted); font-size: 0.88rem; max-width: 42ch; margin: 0.6rem 0 0; }
  .foot-links { display: flex; flex-direction: column; gap: 0.6rem; font-family: var(--font-mono); font-size: 0.82rem; }
  .foot-links a { color: var(--muted); transition: color 0.15s ease; }
  .foot-links a:hover { color: var(--accent); }

  .foot-base {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
    padding-block: 1.75rem 2.5rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.66rem; letter-spacing: 0.06em; color: var(--muted-dim);
  }
</style>
