---
import { SITE } from "../config";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="brand" aria-label="4R home">
      <span class="brand-mark">4R</span>
      <span class="brand-sub mono">/ mr-reviewer</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="#framework">Framework</a>
      <a href="#features">Features</a>
      <a href="#flow">How it works</a>
      <a href={SITE.docs}>Docs</a>
      <a href={SITE.github} class="gh" rel="noopener" target="_blank">GitHub&nbsp;↗</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--canvas) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .brand-mark {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .brand-sub {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .nav-links a {
    color: var(--muted);
    transition: color 0.15s ease;
  }
  /* Touch floor (WCAG 2.5.5): pad links to a >=44px hit target on coarse
     pointers, without disturbing the tight desktop-mouse nav. */
  @media (pointer: coarse) {
    .nav-links a { display: inline-flex; align-items: center; min-height: 44px; }
  }
  .nav-links a:hover { color: var(--ink); }
  .nav-links .gh { color: var(--ink); }
  .nav-links .gh:hover { color: var(--accent); }

  /* Mobile: keep every section anchor reachable in a horizontal scroll strip
     (a hidden nav on a one-page scroller strands the anchors the page is built
     around). Edge mask hints the overflow is scrollable. */
  @media (max-width: 720px) {
    .brand-sub { display: none; }
    .nav-links {
      gap: 1.1rem;
      font-size: 0.75rem;
      margin-left: 1rem;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 0.5rem, #000 calc(100% - 1.25rem), transparent);
      mask-image: linear-gradient(to right, transparent, #000 0.5rem, #000 calc(100% - 1.25rem), transparent);
    }
    .nav-links::-webkit-scrollbar { display: none; }
    .nav-links a { white-space: nowrap; }
  }
</style>
