---
// A real spa-b screenshot, light + dark, switched by the html theme class.
// Hidden variants with loading="lazy" are never fetched, so each visitor
// downloads only the theme they see.
interface Props {
  name: string; // file stem in /public/shots: `${name}-light.webp`, `${name}-dark.webp`
  alt: string;
  caption: string;
  eager?: boolean;
  /** Source height in CSS px (captures are 1280 wide at 2x). */
  height?: number;
  /** Visible height of the frame in CSS px; defaults to the whole capture. */
  view?: number;
  /** Vertical focus 0..1 when `view` crops the capture (0 = top). */
  focus?: number;
}
const { name, alt, caption, eager = false, height = 800, view = height, focus = 0 } = Astro.props;
const loading = eager ? "eager" : "lazy";
const width = 1280;
const frameStyle = `aspect-ratio: ${width} / ${view}; --shot-focus: ${focus * 100}%`;
---

<figure class="shot">
  <div class="shot-frame" style={frameStyle}>
    <img
      class="is-light"
      src={`/shots/${name}-light.webp`}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
    />
    <img
      class="is-dark"
      src={`/shots/${name}-dark.webp`}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
    />
  </div>
  <figcaption><span>{caption}</span><span class="tag">Example data</span></figcaption>
</figure>
