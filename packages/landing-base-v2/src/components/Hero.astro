---
import { SITE } from "../config";

// Each diagram edge is two-way (a down and an up arrow, each labeled) so the
// diagram states exactly what crosses it. R4 is shown as the pass running now.
const lenses = [
  { id: "R1", name: "Risk" },
  { id: "R2", name: "Readability" },
  { id: "R3", name: "Reliability" },
  { id: "R4", name: "Resilience" },
];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">AI review for GitLab merge requests, run on your own server.</h1>
    <p class="lede">
      4R is a service you host. It reads an MR's diff with your GitLab token, reviews it in four
      separate passes using the AI provider account you configure, scores the findings with fixed
      arithmetic, and posts only the findings you select.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="#self-host">Run it yourself</a>
      <a class="btn" href={SITE.docs}>Read the docs</a>
    </div>
    <p class="source">
      Source and issues on <a href={SITE.github}>GitHub</a>. GitLab only, single user, today.
    </p>
  </div>

  <figure class="diagram" aria-labelledby="diagram-caption">
    <div class="node node-gitlab">
      <p class="node-title">GitLab</p>
      <p class="node-meta mono">acme/payments-api</p>
      <p class="mr">
        <span class="mono mr-id">!142</span>
        <span>Retry failed webhook deliveries with exponential backoff</span>
      </p>
    </div>

    <div class="edge">
      <svg class="arrows" viewBox="0 0 24 56" width="24" height="56" aria-hidden="true">
        <path d="M7 4v46M3 45l4 5 4-5"></path>
        <path d="M17 52V6M13 11l4-5 4 5"></path>
      </svg>
      <ul class="edge-labels">
        <li><span class="dir">down</span> the diff, read with your GitLab token</li>
        <li><span class="dir">up</span> the findings you selected, as MR discussions</li>
      </ul>
    </div>

    <div class="boundary">
      <p class="boundary-name">your infrastructure</p>
      <div class="node node-4r">
        <p class="node-title">4R server <span class="mono node-addr">127.0.0.1:8080</span></p>
        <ol class="lenses" aria-label="Review passes">
          {
            lenses.map((lens, i) => (
              <li class:list={["lens", { active: i === 3 }]}>
                <span class="mono">{lens.id}</span> {lens.name}
              </li>
            ))
          }
        </ol>
        <p class="node-meta">
          Score <span class="mono">62</span>, computed from findings. Secrets encrypted at rest.
        </p>
      </div>
    </div>

    <div class="edge">
      <svg class="arrows" viewBox="0 0 24 56" width="24" height="56" aria-hidden="true">
        <path d="M7 4v46M3 45l4 5 4-5"></path>
        <path d="M17 52V6M13 11l4-5 4 5"></path>
      </svg>
      <ul class="edge-labels">
        <li><span class="dir">down</span> the diff and the 4R rules, sent with your API key</li>
        <li><span class="dir">up</span> located findings: file, line, severity</li>
      </ul>
    </div>

    <div class="node node-provider">
      <p class="node-title">Your AI provider account</p>
      <p class="node-meta">Anthropic, or any OpenAI-compatible API</p>
    </div>

    <figcaption id="diagram-caption">
      Where MR !142 goes during a review. The example project is made up.
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    gap: 3rem;
    padding-top: clamp(3rem, 2rem + 5vw, 6rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  @media (min-width: 60rem) {
    .hero-copy {
      padding-top: 1.5rem;
    }
  }
  h1 {
    max-width: 17ch;
  }
  .lede {
    max-width: 52ch;
    font-size: var(--fs-lede);
    line-height: 1.55;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .source {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* ---- Diagram ---- */
  .diagram {
    margin: 0;
    display: grid;
    gap: 0;
    font-size: var(--fs-small);
    line-height: 1.45;
  }
  .mono {
    font-family: var(--font-mono);
  }
  .node {
    padding: 0.875rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-panel);
    display: grid;
    gap: 0.375rem;
  }
  .node-title {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
  }
  .node-addr {
    font-weight: 400;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .node-meta {
    color: var(--text-muted);
  }
  .mr {
    display: flex;
    gap: 0.625rem;
    align-items: baseline;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-app);
    color: var(--text);
  }
  .mr-id {
    flex: none;
    color: var(--accent-text);
    font-weight: 600;
  }

  .edge {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0 0.5rem 1.25rem;
  }
  .arrows {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .edge-labels li {
    display: grid;
    grid-template-columns: 3.25em minmax(0, 1fr);
    align-items: baseline;
  }
  .edge-labels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    color: var(--text-muted);
  }
  .dir {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  /* The boundary: the same hairline + indigo marker as the page rail. */
  .boundary {
    position: relative;
    padding: 1.75rem 0.75rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
  }
  .boundary-name {
    position: absolute;
    top: 0.375rem;
    left: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent-text);
  }
  .boundary-name::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: var(--radius-sm);
    background: var(--accent);
  }
  .node-4r {
    background: var(--bg-panel-raised);
  }
  .lenses {
    list-style: none;
    margin: 0.25rem 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem;
  }
  .lens {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lens .mono {
    color: var(--text);
    font-size: var(--fs-xs);
  }
  .lens.active {
    border-color: var(--accent);
    background: var(--accent-subtle-bg);
    color: var(--accent-text-strong);
  }
  .lens.active .mono {
    color: var(--accent-text-strong);
  }

  .node-provider {
    border-style: solid;
    background: transparent;
  }

  figcaption {
    margin-top: 0.875rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }
</style>
