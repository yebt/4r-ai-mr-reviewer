---
import Stop from "../Stop.astro";

// Mirrors domain/review.Evaluate in packages/server: start at 100, subtract
// 15 / 5 / 1 per high / medium / low finding, 10 more for a blocking one.
// The findings below are example data for MR !142.
type Finding = {
  lens: string;
  severity: "high" | "medium" | "low";
  blocking?: boolean;
  where: string;
  issue: string;
};
const PENALTY = { high: 15, medium: 5, low: 1 } as const;
const BLOCKING = 10;

const findings: Finding[] = [
  { lens: "R4", severity: "high", blocking: true, where: "webhooks/retry.go:48", issue: "Retries have no upper bound; a dead endpoint is retried forever." },
  { lens: "R3", severity: "medium", where: "webhooks/retry.go:61", issue: "The backoff delay overflows after 31 attempts." },
  { lens: "R1", severity: "medium", where: "webhooks/deliver.go:22", issue: "The failed response body is logged, including the customer's payload." },
  { lens: "R2", severity: "low", where: "webhooks/retry.go:12", issue: "maxWait and maxDelay name the same value." },
  { lens: "R2", severity: "low", where: "webhooks/retry.go:35", issue: "The jitter formula has no comment." },
  { lens: "R3", severity: "low", where: "webhooks/retry_test.go:1", issue: "No test covers the attempt after the delay cap." },
];

const cost = (f: Finding) => PENALTY[f.severity] + (f.blocking ? BLOCKING : 0);
const total = findings.reduce((sum, f) => sum + cost(f), 0);
const score = Math.max(0, 100 - total);
---

<Stop id="score" title="The score is computed from the findings, not asked of the model" log={`!142 scored ${score}`}>
  <div class="prose intro">
    <p>
      The model's job ends at the findings. 4R turns them into a 0 to 100 score with fixed
      weights and derives the recommendation from the same list, so the same findings always
      give the same result, and you can check it by hand.
    </p>
  </div>

  <div class="calc">
    <div class="table-scroll" role="region" aria-labelledby="calc-caption" tabindex="0">
      <table>
        <caption id="calc-caption">MR !142, six findings (example data)</caption>
        <thead>
          <tr>
            <th scope="col">Lens</th>
            <th scope="col">Severity</th>
            <th scope="col">Where</th>
            <th scope="col">Finding</th>
            <th scope="col" class="num">Points</th>
          </tr>
        </thead>
        <tbody>
          {
            findings.map((f) => (
              <tr>
                <td class="mono lens">{f.lens}</td>
                <td class="sev">{f.severity}{f.blocking && <span class="blocking">, blocking</span>}</td>
                <td class="mono where">{f.where}</td>
                <td class="issue">{f.issue}</td>
                <td class="num mono pts">-{cost(f)}</td>
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" colspan="4">Score: 100 - {total}</th>
            <td class="num mono total">{score}</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="rules">
      <h3>The rules</h3>
      <ul>
        <li><span class="mono">-15</span> per high, <span class="mono">-5</span> per medium, <span class="mono">-1</span> per low finding.</li>
        <li><span class="mono">-10</span> more for each finding marked blocking.</li>
        <li>Any high or blocking finding: <strong>request changes</strong>.</li>
        <li>Findings, none high or blocking: <strong>comment</strong>.</li>
        <li>No findings: <strong>approve</strong>.</li>
      </ul>
      <p class="verdict">
        !142 has a blocking high finding, so the recommendation is <strong>request changes</strong>.
      </p>
    </div>
  </div>
</Stop>

<style>
  .intro {
    margin-bottom: 2rem;
  }
  .calc {
    display: grid;
    gap: 2rem;
  }
  .rules {
    max-width: 64ch;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
  }
  table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  caption {
    text-align: left;
    padding: 0.75rem 1rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
    border-bottom: 1px solid var(--line-subtle);
  }
  th,
  td {
    padding: 0.625rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line-subtle);
  }
  thead th {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-muted);
  }
  tbody td {
    color: var(--text);
  }
  .where {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .blocking {
    color: var(--danger-text);
  }
  .num {
    text-align: right;
    white-space: nowrap;
  }
  tfoot th,
  tfoot td {
    border-bottom: 0;
    font-weight: 600;
  }
  tfoot th {
    text-align: right;
  }
  .total {
    font-size: 1.25rem;
    color: var(--text);
  }
  /* Narrow screens: each finding becomes a stacked row instead of a
     sideways-scrolling table, so the finding text and points stay visible. */
  @media (max-width: 47.99rem) {
    table {
      min-width: 0;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    tbody tr {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: 0.75rem;
      row-gap: 0.25rem;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--line-subtle);
    }
    tbody td {
      padding: 0;
      border: 0;
    }
    .lens {
      grid-area: 1 / 1;
    }
    .sev {
      grid-area: 1 / 2;
    }
    .pts {
      grid-area: 1 / 3;
    }
    .issue,
    .where {
      grid-column: 1 / -1;
    }
    .where {
      white-space: normal;
      overflow-wrap: anywhere;
    }
    tfoot tr {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 0.75rem 1rem;
    }
    tfoot th,
    tfoot td {
      padding: 0;
    }
  }
  .rules {
    display: grid;
    gap: 0.75rem;
  }
  .rules ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.375rem;
    color: var(--text-muted);
  }
  .rules strong {
    color: var(--text);
    font-weight: 600;
  }
  .verdict {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-subtle);
    color: var(--text-muted);
  }
</style>
