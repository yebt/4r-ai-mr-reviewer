---
import Stop from "../Stop.astro";

const providers = [
  { name: "Anthropic", kind: "Claude models" },
  { name: "OpenAI", kind: "OpenAI-compatible" },
  { name: "Groq", kind: "OpenAI-compatible" },
  { name: "Moonshot (Kimi)", kind: "OpenAI-compatible" },
  { name: "OpenRouter", kind: "OpenAI-compatible" },
];
---

<Stop id="secrets" title="Your keys are encrypted, and the API never returns them" log="secrets sealed">
  <div class="grid">
    <div class="prose">
      <p>
        GitLab tokens, provider API keys and Telegram bot tokens are encrypted at rest with
        <strong>AES-256-GCM</strong> in 4R's SQLite database. The API accepts them and never
        sends them back.
      </p>
      <p>
        The diff goes to the provider account you configured, under your key and that
        provider's terms. 4R has no hosted service of its own in the middle.
      </p>
      <p>
        Password login for the API is available and off by default; turn it on with
        <code>AIR_AUTH_PASSWORD</code> when the server is reachable by anyone but you.
      </p>
    </div>
    <div>
      <h3>Providers</h3>
      <ul class="providers">
        {
          providers.map((p) => (
            <li>
              <span>{p.name}</span>
              <span class="kind">{p.kind}</span>
            </li>
          ))
        }
      </ul>
      <p class="note">
        Set a default provider, a provider and model per repository, or override both when you
        launch a review.
      </p>
    </div>
  </div>
</Stop>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  h3 {
    margin-bottom: 0.75rem;
  }
  .providers {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-subtle);
  }
  .providers li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line-subtle);
  }
  .kind {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
</style>
